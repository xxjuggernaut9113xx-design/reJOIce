    {
      "asset": "ToySettingsMenu",
      "widget": "ConnectMobileLovenseToysButton",
      "function": "Get_ConnectMobileLovenseToysButton_ToolTipWidget",
      "title": {
        "text": "How to Connect to Lovense Mobile App:",
        "key": "9231C5F54FF5A8CE32C32BA6FFFAA256",
        "namespace": ""
      },
      "description": {
        "text": "1. On the Lovense app, go to Discover -> Game Mode\r\n2. Enable LAN\r\n3. Input the IP Address and Port shown\r\n4. Hit Connect Via Mobile App\r\n\r\nMake sure your toy and PC are on the same Wi-Fi network!",
        "key": "732F191447F57AF704F9A9B26525B756",
        "namespace": ""
      },
      "function_sha256": "356ff5bf53f1fe2daec143d2abf3ed07e15ea52d27fcfe83b3a2829cfbcacd9f"
    },
    {
      "asset": "ToySettingsMenu",
      "widget": "ConnectLovenseToysButton",
      "function": "Get_ConnectLovenseToysButton_ToolTipWidget",
      "title": {
        "text": "How to Connect via Lovense PC App:",
        "key": "89B2255D49B06492E9C134B85503F742",
        "namespace": ""
      },
      "description": {
        "text": "1. Go to Start -> Settings -> Devices -> Bluetooth in Windows\r\n2. Turn Bluetooth On\r\n3. Select the device starting with \"LVS-\" and click Pair\r\n4. If prompted for a code, enter 0000\r\n5. Open the Lovense Connect app — your toy should auto-connect\r\n6. Then click \"Connect via PC App\" in-game",
        "key": "B4FD008040F570F90B6EE79480E2B322",
        "namespace": ""
      },
      "function_sha256": "7f383383fccb0de90c7abcaf432d3c0cba6e60f19a9b5d4b4147793815531870"
    },
    {
      "asset": "ToySettingsMenu",
      "widget": "HandyConnectButtonV2",
      "function": "Get_HandyConnectButtonV2_ToolTipWidget",
      "title": {
        "text": "How to Find Your Handy Connection Key:",
        "key": "9C598E834A395916446021901FE4707D",
        "namespace": ""
      },
      "description": {
        "text": "1. Go to handyfeeling.com/setup and complete setup\r\n2. After setup, click the top-right menu button\r\n3. Copy your Connection Key from the popup\r\n4. Or use the Handyverse or Onboarding app — key is shown under your device\r\n5. The key is case-sensitive (bold = uppercase, red = numbers)\r\n6. In-game, paste the key into the Handy Settings and press Connect\r\n\r\nAnyone with the key can control your device — keep it private!\r\n\r\n(Your Handy Must Be on Firmware V4 or Higher)",
        "key": "C8D6D3BB495801B68B1071977DC84614",
        "namespace": ""
      },
      "function_sha256": "d20f9e90fb4f2507f13dc00a8c62c1f1a8f8209215437fb8af64e94f000c9b05"
    },
